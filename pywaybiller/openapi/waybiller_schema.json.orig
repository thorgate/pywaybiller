                          "origin_name": "Quarry 4",
                          "order_number": null,
                          "vehicle_reg_number": null,
                          "trailer_reg_number": null,
                          "waybill_number": null,
                          "loader_unit_name": "Liebherr L 576",
                          "assortment_name": "Screens",
                          "subset_name": "0-4 mm",
                          "weight": "9.550",
                          "log_comments": [],
                          "raw_data": {
                            "log_id": 123456,
                            "loader_operator_user_id": 4321,
                            "origin_id": 1,
                            "order_id": null,
                            "vehicle_id": null,
                            "loader_unit_id": 100,
                            "assortment_id": 4200,
                            "subset_id": 3
                          }
                        }
                      ]
                    },
                    "summary": "Example loader action log"
                  }
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "Provided API key is not correct or expired",
                      "description": "Provided API key is not correct or expired"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
