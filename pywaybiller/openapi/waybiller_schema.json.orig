          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of objects to return per page",
            "schema": {
              "type": "integer",
              "default": 30,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "tags": [
          "Vehicles"
        ],
        "security": [
