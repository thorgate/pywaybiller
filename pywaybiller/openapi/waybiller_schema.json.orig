      "post": {
        "operationId": "orders_create",
        "description": "Creates a new order.<br><br>\n        **NB!** All posted IDs are IDs in your system and these are used to match objects in your system with objects in Waybiller.\n        It is also possible to use the Waybiller IDs (`_raw_id`)\n        (if you have received it via GET endpoints (e.g. Destinations, Origin assortments).\n        Exception is `client`, where the `reg_code` is used as raw id.\n        ",
        "summary": "Creation of an order",
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalAPIOrderCreateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAPIOrderCreate"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "Provided API key is not correct or expired",
                      "description": "Provided API key is not correct or expired"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
