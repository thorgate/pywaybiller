    "/external-api/waybills/": {
      "get": {
        "operationId": "waybills_list",
        "description": "Returns all waybills associated with your company, according to the specified filters.<br><br>\n        **NB!** By default, past 30 days according to the `dispatcher_timestamp` field waybills are returned. Use\n        `dispatcher_timestamp__lt` and `dispatcher_timestamp__gt` for filtering. Note that the maximum range is 30 days.\n        ",
        "summary": "Querying of waybills",
        "parameters": [
          {
            "in": "query",
            "name": "destination_ids",
            "schema": {
              "type": "string"
            },
            "description": "Filters waybills with a specified list of destination IDs from your system. Multiple values may be separated by commas."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of objects to return per page",
            "schema": {
              "type": "integer",
              "default": 30,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "origin_ids",
            "schema": {
              "type": "string"
            },
            "description": "Filters waybills with a specified list of origin IDs from your systemMultiple values may be separated by commas."
          },
          {
            "in": "query",
            "name": "raw_destination_ids",
            "schema": {
              "type": "string"
            },
            "description": "Filters waybills with a specified list of raw destination IDs. Multiple values may be separated by commas."
          },
          {
            "in": "query",
            "name": "raw_origin_ids",
            "schema": {
              "type": "string"
            },
            "description": "Filters waybills with a specified list of raw origin IDs. Multiple values may be separated by commas."
          },
          {
            "in": "query",
            "name": "transportation_cost_confirmed_at_timestamp__gt",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filters waybills with a transportation cost confirmed timestamp greater than the specified value. The value must be in ISO 8601 format."
          },
          {
            "in": "query",
            "name": "transportation_cost_confirmed_at_timestamp__lt",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filters waybills with a transportation cost confirmed timestamp less than the specified value. The value must be in ISO 8601 format."
          }
        ],
        "tags": [
          "Waybills"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedExternalAPIWaybillListList"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "Provided API key is not correct or expired",
                      "description": "Provided API key is not correct or expired"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "waybills_create",
        "description": "Creates a new waybill.<br><br>\n        **NB!** IDs posted this way are IDs in your system and these are used to match objects in\n        your system with objects in Waybiller.\n        It is also possible to use the origin or destination ID in Waybiller\n        (if you have received those via GET Origins or GET Destinations endpoints).\n        ",
        "summary": "Creation of a waybill",
        "tags": [
          "Waybills"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalAPIWaybillCreateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAPIWaybillCreate"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "Provided API key is not correct or expired",
                      "description": "Provided API key is not correct or expired"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
