    "/external-api/origin-assortments/": {
      "get": {
        "operationId": "origin_assortments_list",
        "description": "Returns all origin assortments associated with your company based on specified filters.\n\nAvailable assortments include:\n- Your company's origin assortments\n- Your partner companies' origin assortments\n- Public origin assortments\n",
        "summary": "Querying origin assortments",
        "parameters": [
          {
            "in": "query",
            "name": "assortment__name",
            "schema": {
              "type": "string"
            },
            "description": "Filters origin assortments by exact assortment name (case-sensitive)"
          },
          {
            "in": "query",
            "name": "assortment__name__contains",
            "schema": {
              "type": "string"
            },
            "description": "Filters origin assortments where the assortment name contains the specified keyword (case-sensitive)"
          },
          {
            "in": "query",
            "name": "assortment__name__icontains",
            "schema": {
              "type": "string"
            },
            "description": "Filters origin assortments where the assortment name contains the specified keyword (case-insensitive)"
          },
          {
            "in": "query",
            "name": "assortment__name__iexact",
            "schema": {
              "type": "string"
            },
            "description": "Filters origin assortments by exact assortment name (case-insensitive)"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of objects to return per page",
            "schema": {
              "type": "integer",
              "default": 30,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results",
            "schema": {
              "type": "integer",
              "default": 0,
