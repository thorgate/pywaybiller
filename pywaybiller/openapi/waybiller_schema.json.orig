          }
        },
        "required": [
          "driver_user_id"
        ]
      },
      "ExternalAPIWaybillTransportCosts": {
        "type": "object",
        "properties": {
          "incoterm": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IncotermEnum"
              }
            ],
            "readOnly": true,
            "description": "The incoterm for which the transport cost is calculated.\n\n* `EXW` - EXW (Ex Works)\n* `DAP` - DAP (Delivered At Place)"
          },
          "pricing_system": {
            "readOnly": true,
            "description": "The price used to calculate the transport cost.\n\n* `coefficient_price` - Coefficient price\n* `ton_price` - Ton price\n* `mileage_price` - Mileage price\n* `load_price` - Load price",
            "oneOf": [
              {
                "$ref": "#/components/schemas/PricingSystemEnum"
              },
              {
                "$ref": "#/components/schemas/BlankEnum"
              }
            ]
          },
          "load_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The price used to calculate the transport cost for load pricing system."
          },
          "transport_coefficient": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,1}(?:\\.\\d{0,7})?$",
            "readOnly": true,
            "description": "The transport coefficient used to calculate the transport cost."
          },
          "minimum_unit_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The minimum unit price used to calculate the transport cost."
          },
          "weights_to_use": {
            "readOnly": true,
            "description": "The weights used to calculate the transport cost.\n\n* `accepted_weights` - Accepted weights\n* `dispatched_weights` - Dispatched weights",
            "oneOf": [
              {
                "$ref": "#/components/schemas/WeightsToUseEnum"
              },
              {
                "$ref": "#/components/schemas/BlankEnum"
              }
            ]
          },
          "tonnes": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,5}(?:\\.\\d{0,3})?$",
            "readOnly": true,
            "description": "Amount in tonnes to be used to calculate the transport cost."
          },
          "ton_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The price used to calculate the transport cost for ton pricing system."
          },
          "mileage_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The price used to calculate the transport cost for mileage pricing system."
          },
          "mileage": {
            "type": "integer",
            "maximum": 32767,
            "minimum": 0,
            "readOnly": true,
            "description": "The distance in kilometers used to calculate the transport cost."
          },
          "waiting_hours": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,3}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The number of hours the driver waited."
          },
          "waiting_hours_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The cost of waiting for one hour."
          },
          "extra_costs": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "Extra costs for the transport."
          },
          "transport_cost_value": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,11}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "description": "The calculated transport cost value."
          },
          "transport_cost_calculation": {
            "type": "string",
            "readOnly": true,
            "description": "The calculation of the transport cost.",
            "maxLength": 100
          },
          "last_saved_by_email": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "The e-mail address of the user that last saved the transport costs. If confirmation time is set, then this user confirmed the costs"
          },
          "last_saved_by_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "The name of the user that last saved the transport costs"
          },
          "last_saved_by_company_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "The company name of the user that last saved the transport costs"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "nullable": true,
            "description": "The time when the transport cost was confirmed."
          }
        },
        "required": [
          "confirmed_at",
          "extra_costs",
          "incoterm",
          "last_saved_by_company_name",
          "last_saved_by_email",
          "last_saved_by_name",
          "load_price",
          "mileage",
          "mileage_price",
          "minimum_unit_price",
          "pricing_system",
          "ton_price",
          "tonnes",
          "transport_coefficient",
          "transport_cost_calculation",
          "transport_cost_value",
          "waiting_hours",
          "waiting_hours_price",
          "weights_to_use"
        ]
      },
      "ExternalAPIWaybillVehicleLocation": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double",
            "readOnly": true,
            "description": "The latitude coordinate of the vehicle (eg 59.401034)."
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "readOnly": true,
            "description": "The longitude coordinate of the vehicle (eg 24.791717)."
          },
          "location_timestamp": {
            "type": "string",
            "readOnly": true,
            "description": "UTC timestamp when vehicle was in that position (eg 2020-05-08T19:06:33)."
          }
        },
        "required": [
          "latitude",
          "location_timestamp",
          "longitude"
        ]
      },
      "IncotermEnum": {
        "enum": [
          "EXW",
          "DAP"
        ],
        "type": "string",
        "description": "* `EXW` - EXW (Ex Works)\n* `DAP` - DAP (Delivered At Place)"
      },
      "LanguageEnum": {
        "enum": [
          "et",
          "ru",
          "en",
          "us",
          "lv",
          "fi",
          "nb",
          "pl"
        ],
        "type": "string",
        "description": "* `et` - Eesti\n* `ru` - \u0420\u0443\u0441\u0441\u043a\u0438\u0439\n* `en` - English\n* `us` - English (US)\n* `lv` - Latviski\n* `fi` - Suomi\n* `nb` - Norsk\n* `pl` - Polski"
      },
      "PaginatedExternalAPIDestinationList": {
        "type": "object",
        "required": [
          "count",
          "next",
          "previous",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "example": 123,
            "description": "Total number of objects matching the provided query"
          },
          "next": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "https://app.waybiller.com/external-api/destinations/?limit=30&offset=90",
            "description": "URL to the next page of results, or null if there are no additional pages"
          },
          "previous": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "https://app.waybiller.com/external-api/destinations/?limit=30&offset=30",
            "description": "URL to the previous page of results, or null if it's the first page"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPIDestination"
            }
          }
        }
      },
