{
  "openapi": "3.0.3",
  "info": {
    "title": "Waybiller External API",
    "version": "v1",
    "description": "The **Waybiller External API** is a feature that allows companies to access **Waybiller** data as JSON objects and\ncreate **Waybiller** instances out of their own data.\n\nTo make integration easier for the companies, the external API provides mapping support - it is possible to create\ncompany-specific mappings for object identifiers (such as destination and origin).\n\nThese mappings will be used for representing companies data from external API, and for converting the values during the\ncreation of **Waybiller** instances (such as transport orders and waybills).\n\nMost of the API responses contain mapped values, which may be null if the company doesn't have a mapping for this\nobject.\n\nUnique **Waybiller** identifiers and values can be accessed via the `raw_data` key.\n\nThe API is HTTPS and JSON based.\n\n### Pagination\n\nBy default, list endpoint responses are presented in pages of 30 items.\n\nIt is possible to control the page size using the `limit` parameter:\n`/external-api/<some-list-endpoint>/?limit=<number>`, where `<number>` is an integer between 1 and 1000.\n"
  },
  "paths": {
    "/external-api/destinations/": {
      "get": {
        "operationId": "destinations_list",
        "description": "Returns all destinations associated with your company according to the specified filters",
        "summary": "Querying destinations",
        "parameters": [
          {
            "in": "query",
            "name": "company__reg_code",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations that belong to the company with the specified registration code (case-sensitive)"
          },
          {
            "in": "query",
            "name": "company__reg_code__contains",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations that belong to companies whose registration codes contain this keyword (case-sensitive)"
          },
          {
            "in": "query",
            "name": "company__reg_code__icontains",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations that belong to companies whose registration codes contain this keyword (case-insensitive)"
          },
          {
            "in": "query",
            "name": "company__reg_code__iexact",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations that belong to the company with the specified registration code (case-insensitive)"
          },
          {
            "in": "query",
            "name": "explicitly_viewable",
            "schema": {
              "type": "boolean"
            },
            "description": "Filters destinations that belong to your company or where your company was added as a partner"
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of objects to return per page",
            "schema": {
              "type": "integer",
              "default": 30,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "location__address",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations with the specified address (case-sensitive)"
          },
          {
            "in": "query",
            "name": "location__address__contains",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations whose addresses contain this keyword (case-sensitive)"
          },
          {
            "in": "query",
            "name": "location__address__icontains",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations whose addresses contain this keyword (case-insensitive)"
          },
          {
            "in": "query",
            "name": "location__address__iexact",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations with the specified address (case-insensitive)"
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations with the specified name (case-sensitive)"
          },
          {
            "in": "query",
            "name": "name__contains",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations whose names contain this keyword (case-sensitive)"
          },
          {
            "in": "query",
            "name": "name__icontains",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations whose names contain this keyword (case-insensitive)"
          },
          {
            "in": "query",
            "name": "name__iexact",
            "schema": {
              "type": "string"
            },
            "description": "Filters destinations with the specified name (case-insensitive)"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "tags": [
          "Destinations"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedExternalAPIDestinationList"
                },
                "examples": {
                  "ExampleDestination": {
                    "value": {
                      "count": 123,
                      "next": "https://app.waybiller.com/external-api/destinations/?limit=30&offset=90",
                      "previous": "https://app.waybiller.com/external-api/destinations/?limit=30&offset=30",
                      "results": [
                        {
                          "id": null,
                          "name": "Waybiller O\u00dc",
                          "address": "M\u00e4ealuse tn 2/1, Tallinn",
                          "latitude": 59.3962767,
                          "longitude": 24.6592268,
                          "owner_name": "Waybiller O\u00dc",
                          "owner_reg_code": "14200010",
                          "raw_data": {
                            "id": 1
                          }
                        }
                      ]
                    },
                    "summary": "Example destination"
                  }
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "Provided API key is not correct or expired",
                      "description": "Provided API key is not correct or expired"
                    }
                  }
                }
              }
            },
            "description": ""
          }
        }
      }
    },
