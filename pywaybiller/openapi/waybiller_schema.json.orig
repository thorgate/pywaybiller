    "/external-api/loader-action-logs/": {
      "get": {
        "operationId": "loader_action_logs_list",
        "description": "Returns all loader action logs created by your company according to the specified filters.",
        "summary": "Querying loader action logs",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of objects to return per page",
            "schema": {
              "type": "integer",
              "default": 30,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "loader_unit_id",
            "schema": {
              "type": "integer"
            },
            "description": "Filters loader action logs for your company with the specified loader unit ID"
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The initial index from which to return the results",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "in": "query",
            "name": "timestamp",
            "schema": {
              "type": "string"
            },
            "description": "Filters loader action logs for your company within the specified time period (exact)"
          },
          {
            "in": "query",
            "name": "timestamp__gt",
            "schema": {
              "type": "string"
            },
            "description": "Filters loader action logs for your company within the specified time period (greater than)"
          },
          {
            "in": "query",
            "name": "timestamp__gte",
            "schema": {
              "type": "string"
            },
            "description": "Filters loader action logs for your company within the specified time period (greater than or equal)"
          },
          {
            "in": "query",
            "name": "timestamp__isnull",
            "schema": {
              "type": "string"
            },
            "description": "Filters loader action logs for your company that do not have a timestamp"
          },
          {
            "in": "query",
            "name": "timestamp__lt",
            "schema": {
              "type": "string"
            },
            "description": "Filters loader action logs for your company within the specified time period (less than)"
          },
          {
            "in": "query",
            "name": "timestamp__lte",
            "schema": {
              "type": "string"
            },
            "description": "Filters loader action logs for your company within the specified time period (less than or equal)"
          }
        ],
        "tags": [
          "Loader action logs"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedExternalAPILoaderActionLogList"
                },
                "examples": {
                  "ExampleLoaderActionLog": {
                    "value": {
                      "count": 123,
                      "next": "https://app.waybiller.com/external-api/loader-action-logs/?limit=30&offset=90",
                      "previous": "https://app.waybiller.com/external-api/loader-action-logs/?limit=30&offset=30",
                      "results": [
                        {
                          "log_timestamp": "2025-01-01T12:42:01.862696+02:00",
                          "log_description": "/ Quarry 4 / Liebherr L 576 / Create waybill (Waybiller O\u00dc) / / / / / Screens [0-4 mm] / / 9.550",
                          "loader_operator_user_name": "John Doe",
