  "components": {
    "schemas": {
      "BlankEnum": {
        "enum": [
          ""
        ]
      },
      "ExternalAPIDestination": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "ID of the destination in your system",
            "deprecated": true
          },
          "name": {
            "type": "string",
            "readOnly": true,
            "description": "Name of the destination",
            "maxLength": 255
          },
          "address": {
            "type": "string",
            "readOnly": true,
            "description": "Physical address of the destination",
            "maxLength": 255,
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "maximum": 90,
            "minimum": -90,
            "readOnly": true,
            "description": "Latitude coordinate of the destination's location"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "maximum": 180,
            "minimum": -180,
            "readOnly": true,
            "description": "Longitude coordinate of the destination's location"
          },
          "owner_name": {
            "type": "string",
            "readOnly": true,
            "description": "Name of the destination's owner company",
            "maxLength": 64,
            "minLength": 1
          },
          "owner_reg_code": {
            "type": "string",
            "readOnly": true,
            "description": "Registration code of the destination's owner company",
            "maxLength": 16,
            "minLength": 1
          },
          "raw_data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalAPIDestinationRawData"
              }
            ],
            "readOnly": true,
            "description": "The IDs of the Waybiller internal objects"
          }
        },
        "required": [
          "address",
          "id",
          "latitude",
          "longitude",
          "name",
          "owner_name",
          "owner_reg_code",
          "raw_data"
        ]
      },
      "ExternalAPIDestinationRawData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "description": "Destination ID"
          }
        },
        "required": [
          "id"
        ]
      },
      "ExternalAPIEmployment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "description": "Unique identifier of the employment"
          },
          "name": {
            "type": "string",
            "readOnly": true,
            "description": "Full name of the employee",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "readOnly": true,
            "description": "Email address of the employee",
            "maxLength": 254
          },
          "user_id": {
            "type": "string",
            "readOnly": true,
            "description": "Unique identifier of the employee's user account in Waybiller",
            "maxLength": 10
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleEnum"
              }
            ],
            "readOnly": true,
            "description": "User's role within the company\n\n* `manager` - Manager\n* `project_manager` - Project Manager\n* `object_manager` - Object Manager\n* `dispatcher` - Dispatcher\n* `driver` - Driver\n* `acceptor` - Acceptor\n* `loader_operator` - Loader operator"
          },
          "obsolete": {
            "type": "boolean",
            "readOnly": true,
            "default": false,
            "description": "Whether the employment has been deactivated"
          },
          "company_name": {
            "type": "string",
            "readOnly": true,
            "description": "Name of the employing company",
            "maxLength": 64
          },
          "company_reg_code": {
            "type": "string",
            "readOnly": true,
            "description": "Registration code of the employing company",
            "maxLength": 16
          },
          "subcontractor_company_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Name of the subcontractor company, if applicable",
            "maxLength": 64
          },
          "subcontractor_company_reg_code": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Registration code of the subcontractor company, if applicable",
            "maxLength": 16
          }
        },
        "required": [
          "company_name",
          "company_reg_code",
          "email",
          "id",
          "name",
          "obsolete",
          "role",
          "subcontractor_company_name",
          "subcontractor_company_reg_code",
          "user_id"
        ]
      },
      "ExternalAPIHoldingBase": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TypeEnum"
          },
          "contractNumber": {
            "type": "string",
            "maxLength": 32
          },
          "contractDate": {
            "type": "string",
            "maxLength": 32
          },
