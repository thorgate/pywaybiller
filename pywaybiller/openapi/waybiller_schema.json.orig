              "type": "string"
            },
            "description": "Filters transport orders with a specified list of destination IDs from your system. Multiple values may be separated by commas."
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filters transport orders that have transport date on or before the specified date."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
