    "/external-api/waybills/{id}/update_custom_fields/": {
      "put": {
        "operationId": "waybills_update_custom_fields_update",
        "description": "Updates custom fields defined by the customer support.<br>\n        The values of the fields must match the type assigned to the field. If the field is of type `timestamp`,\n        the value must be an integer representing the timestamp in milliseconds.\n        ",
