          "code",
          "name"
        ]
      },
      "ExternalAPIHoldingBaseRequest": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TypeEnum"
          },
          "contractNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "contractDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "previousOwner": {
            "$ref": "#/components/schemas/ExternalAPIHoldingBasePreviousOwnerRequest"
          }
        }
      },
      "ExternalAPILoaderActionLog": {
        "type": "object",
        "properties": {
          "log_timestamp": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Exact date and time when the loading action was recorded (Format: `YYYY-MM-DDThh:mm:ss.ffffff+hh:mm`)"
          },
          "log_description": {
            "type": "string",
            "readOnly": true,
            "description": "Detailed description of the loading action and its associated context"
          },
          "loader_operator_user_name": {
            "type": "string",
            "readOnly": true,
            "description": "The full name of the loader operator",
            "maxLength": 255
          },
          "action_name": {
            "type": "string",
            "readOnly": true,
            "description": "Name of the loader action that was performed",
            "maxLength": 1024
          },
          "origin_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Name of the origin where the loading action was performed",
            "maxLength": 255
          },
          "order_number": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Number of the order associated with the action, if applicable",
            "maxLength": 16
          },
          "vehicle_reg_number": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Registration number of the vehicle associated with the action, if applicable",
            "maxLength": 16
          },
          "trailer_reg_number": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Registration number of the attached trailer, if applicable",
            "maxLength": 16
          },
          "waybill_number": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Number of the waybill associated with the action, if applicable",
            "maxLength": 16
          },
          "loader_unit_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Identification or name of the loading equipment that was used",
            "maxLength": 1024
          },
          "assortment_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Name of the assortment associated with the action",
            "maxLength": 255
          },
          "subset_name": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Name of the subset associated with the action",
            "maxLength": 64
          },
          "weight": {
            "type": "string",
            "readOnly": true,
            "nullable": true,
            "description": "Weight that was loaded or unloaded (e.g., `\"12.345\"`)"
          },
          "log_comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPILoaderActionLogComment"
            },
            "readOnly": true,
            "description": "List of all comments added to this action"
          },
          "raw_data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalAPILoaderActionLogRawData"
              }
            ],
            "readOnly": true,
            "description": "The IDs of the Waybiller internal objects"
          }
        },
        "required": [
          "action_name",
          "assortment_name",
          "loader_operator_user_name",
          "loader_unit_name",
          "log_comments",
          "log_description",
          "log_timestamp",
          "order_number",
          "origin_name",
          "raw_data",
          "subset_name",
          "trailer_reg_number",
          "vehicle_reg_number",
          "waybill_number",
          "weight"
        ]
      },
      "ExternalAPILoaderActionLogComment": {
        "type": "object",
        "properties": {
          "author_name": {
            "type": "string",
            "readOnly": true,
            "description": "Full name of the person who wrote the comment",
            "maxLength": 255
          },
          "author_company_name": {
            "type": "string",
            "readOnly": true,
            "description": "Company that the comment author represents",
            "maxLength": 64
          },
          "comment": {
            "type": "string",
            "readOnly": true,
            "description": "Full text content of the comment with no length restriction"
          },
          "created_timestamp": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Date and time when the comment was submitted (Format: `YYYY-MM-DDThh:mm:ss.ffffff+hh:mm`)"
          }
        },
        "required": [
          "author_company_name",
          "author_name",
          "comment",
          "created_timestamp"
        ]
      },
      "ExternalAPILoaderActionLogRawData": {
        "type": "object",
        "properties": {
          "log_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "description": "Unique identifier of the loader action log"
          },
          "loader_operator_user_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "description": "Unique identifier of the user operating the loader"
          },
          "origin_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "description": "Unique identifier of the origin where the action was performed"
          },
          "order_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "nullable": true,
            "description": "Unique identifier of the associated order, if applicable"
          },
          "vehicle_id": {
            "type": "integer",
            "readOnly": true,
            "nullable": true,
            "description": "Unique identifier of the vehicle involved in the action, if applicable"
          },
          "loader_unit_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "description": "Unique identifier of the used loader unit"
          },
          "assortment_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "nullable": true,
            "description": "Unique identifier of the loaded assortment, if applicable"
          },
          "subset_id": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true,
            "nullable": true,
            "description": "Unique identifier of the assortment subset, if applicable"
          }
        },
        "required": [
          "assortment_id",
          "loader_operator_user_id",
          "loader_unit_id",
          "log_id",
          "order_id",
          "origin_id",
          "subset_id",
          "vehicle_id"
        ]
      },
      "ExternalAPIOrder": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "readOnly": true,
            "description": "Order number."
          },
          "status": {
            "type": "string",
            "readOnly": true,
            "description": "The status of the order."
          },
          "order_id": {
            "type": "string",
            "description": "Order id (in your system)."
          },
          "order_raw_id": {
            "type": "string",
            "readOnly": true,
            "description": "Order raw id."
          },
          "period": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "description": "The date range when the order is active."
          },
          "owner_raw_id": {
            "type": "string",
            "readOnly": true,
            "description": "Raw id of the owner company."
          },
          "owner_company_name": {
            "type": "string",
            "readOnly": true,
            "description": "Name of the company who owns the order."
          },
          "client_id": {
            "type": "string",
            "description": "The company id (in your system) for whom the order is created for."
          },
          "client_company_reg_code": {
            "type": "string",
            "description": "The company reg code for whom the order is created for. Used as raw id to match the company, if it exists."
          },
          "client_company_name": {
            "type": "string",
            "description": "Name of the company for whom the order is created for."
          },
          "destination_raw_id": {
            "type": "string",
            "description": "Destination raw id."
          },
          "destination_id": {
            "type": "integer",
            "description": "Destination id (in your system)."
          },
          "destination_name": {
            "type": "string",
            "description": "Destination name."
          },
          "destination_address": {
            "type": "string",
            "description": "Destination address.",
            "maxLength": 255
          },
          "destination_latitude": {
            "type": "number",
            "format": "double",
            "description": "Destination location - latitude."
          },
          "destination_longitude": {
            "type": "number",
            "format": "double",
            "description": "Destination location - longitude."
          },
          "origins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPIOrderOrigin"
            },
            "description": "The origins for which the order is created for."
          },
          "total_allowed_amount": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,7}(?:\\.\\d{0,3})?$",
            "description": "Total allowed amount."
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPIOrderOriginsAssortments"
            },
            "description": "Origin's assortments."
          },
          "transportation_companies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPIOrderTransportCompanies"
            },
            "description": "The transportation companies the client is using for transporting assortments from origins to destination."
          },
          "client_can_edit_transportation_values": {
            "type": "boolean",
            "description": "Client can edit transportation values."
          },
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPIOrderVehicles"
            },
            "description": "The vehicles that the transportation companies are allowed to use for this order."
          },
          "extra_information": {
            "type": "string",
            "description": "Extra information."
          },
          "user_id": {
            "type": "integer",
            "description": "User who created this order."
          },
          "raw_data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalAPIOrderRawData"
              }
            ],
            "readOnly": true,
            "description": "The IDs of the Waybiller internal objects"
          }
        },
        "required": [
          "number",
          "order_id",
          "order_raw_id",
          "owner_company_name",
          "owner_raw_id",
          "period",
          "raw_data",
          "status",
          "user_id"
        ]
      },
