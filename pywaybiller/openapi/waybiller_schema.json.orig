        "type": "string",
        "description": "* `ForestNotice` - ForestNotice\n* `WithoutForestNotice` - WithoutForestNotice\n* `InventoryAct` - InventoryAct\n* `ConsolidatedAct` - ConsolidatedAct\n* `ForestAct` - ForestAct\n* `SalesContract` - SalesContract\n* `ContractForTransferOfCuttingRights` - ContractForTransferOfCuttingRights"
      },
      "WaybillStatusEnum": {
        "enum": [
          0,
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "description": "* `0` - Created\n* `1` - In progress\n* `2` - At destination\n* `3` - Confirmed\n* `4` - Cancelled"
      },
      "WeightsToUseEnum": {
        "enum": [
          "accepted_weights",
          "dispatched_weights"
