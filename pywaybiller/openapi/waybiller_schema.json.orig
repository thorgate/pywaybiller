      "ExternalAPIOriginCreate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true,
            "description": "Unique identifier of the origin"
          },
          "name": {
            "type": "string",
            "description": "Name of the origin",
            "maxLength": 255
          },
          "location": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalAPIOriginLocation"
              }
            ],
            "description": "Physical location of the origin"
          },
          "assortments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalAPIOriginAssortment"
            },
            "description": "List of assortments available at the origin"
          },
          "partner_companies": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Registration code"
            },
            "description": "List of registry codes of partner companies"
          },
          "public": {
            "type": "boolean",
            "default": false,
            "description": "Indicates whether the origin is visible to all companies or only to the owner company and authorized partners"
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Indicates whether the origin is currently active and available for use"
          },
          "holding_base": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalAPIHoldingBase"
              }
            ],
            "description": "Holding base data is provided as is, in internal WB format. It may change at any time without warning and may have a different schema for old and new origins"
          },
          "cadaster_number": {
            "type": "string",
            "description": "Cadaster number of the origin in free form. Required if holding base is sent",
            "maxLength": 500
          },
          "extra_information": {
            "type": "string",
            "description": "Additional information about the origin that doesn't fit in other fields",
            "maxLength": 254
          },
          "representative_name": {
            "type": "string",
            "description": "Name of the person representing this origin",
            "maxLength": 64
          },
          "representative_phone": {
            "type": "string",
            "description": "Contact phone number for the origin representative",
            "maxLength": 128
          },
          "waybill_created_emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254
            },
            "nullable": true,
            "title": "Send e-mail when waybill is created",
            "description": "E-mail addresses where notifications will be sent when a waybill is created"
          },
          "waybill_accepted_emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254
            },
            "nullable": true,
            "title": "Send e-mail when waybill is accepted",
            "description": "E-mail addresses where notifications will be sent when a waybill is accepted"
          },
          "waybill_reached_destination_emails": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "maxLength": 254
