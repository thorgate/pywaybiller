          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedExternalAPIVehicleList"
                },
                "examples": {
                  "ExampleVehicle": {
                    "value": {
                      "count": 123,
                      "next": "https://app.waybiller.com/external-api/vehicles/?limit=30&offset=90",
                      "previous": "https://app.waybiller.com/external-api/vehicles/?limit=30&offset=30",
                      "results": [
                        {
                          "id": 1,
                          "reg_number": "ABC123",
                          "trailer_reg_number": "XYZ789",
                          "inactive": false,
                          "company_name": "Waybiller O\u00dc",
                          "company_reg_code": "14200010"
                        }
                      ]
                    },
                    "externalValue": "545",
