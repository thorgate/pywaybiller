        "enum": [
          "manager",
          "project_manager",
          "object_manager",
          "dispatcher",
          "driver",
          "acceptor",
          "loader_operator"
        ],
        "type": "string",
        "description": "* `manager` - Manager\n* `project_manager` - Project Manager\n* `object_manager` - Object Manager\n* `dispatcher` - Dispatcher\n* `driver` - Driver\n* `acceptor` - Acceptor\n* `loader_operator` - Loader operator"
      },
      "TransportOrderStatusEnum": {
        "enum": [
          "draft",
          "new",
          "approaching_origin",
          "approaching_destination",
          "in_destination",
          "accepted",
          "cancelled"
        ],
        "type": "string",
        "description": "* `draft` - Draft\n* `new` - New\n* `approaching_origin` - Approaching origin\n* `approaching_destination` - Approaching destination\n* `in_destination` - In destination\n* `accepted` - Accepted\n* `cancelled` - Cancelled"
      },
      "TypeEnum": {
        "enum": [
          "ForestNotice",
          "WithoutForestNotice",
          "InventoryAct",
          "ConsolidatedAct",
          "ForestAct",
          "SalesContract",
          "ContractForTransferOfCuttingRights"
